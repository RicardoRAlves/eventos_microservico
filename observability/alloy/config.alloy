local.file_match "test_logs" {
  path_targets = [
    {
      __path__     = "/var/log/app/teste.log",
      service_name = "observability_test",
      environment  = "local",
      runtime      = "file",
    },
  ]
}

loki.source.file "test_logs" {
  targets    = local.file_match.test_logs.targets
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}